# Copiar este archivo como .env y ajustar los valores si es necesario.
# Ninguno de los valores de este archivo es un secreto real.

# Ruta del archivo SQLite local que usa Keystone.
DATABASE_URL="file:./keystone.db"

# Clave de sesion para produccion (no es necesaria en desarrollo local;
# Keystone usa una clave fija de desarrollo si se omite esta variable).
# SESSION_SECRET="reemplazar-por-un-valor-aleatorio-de-al-menos-32-caracteres"

# Contrasena opcional para el usuario docente de prueba creado por "npm run seed".
# Si no se define, el seed usa la contrasena de prueba documentada en README.md.
# SEED_TEACHER_PASSWORD="Demo12345!"
